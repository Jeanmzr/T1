"""
Proyecto: Administrador de Puestos de Trabajo
Permite registrar, mostrar, borrar y buscar puestos de trabajo,
además de calcular una "lista más valiosa" de puestos a cubrir
según un presupuesto, usando algoritmos clásicos de ordenamiento
y búsqueda implementados manualmente (sin usar sort() de Python).
"""


class Puesto:
    """Representa un puesto de trabajo disponible en la empresa."""

    def __init__(self, codigo, descripcion, areaSolicitante, sueldo):
        self.codigo = codigo                      # int
        self.descripcion = descripcion            # string
        self.areaSolicitante = areaSolicitante    # string
        self.sueldo = sueldo                      # float

    def __str__(self):
        return (f"Código: {self.codigo:<5} | "
                f"Descripción: {self.descripcion:<28} | "
                f"Área: {self.areaSolicitante:<20} | "
                f"Sueldo: S/ {self.sueldo:,.2f}")


# Lista global que almacena todos los puestos de trabajo
puestos = []


# ---------------------------------------------------------------------------
# 1) AgregaPuesto
# ---------------------------------------------------------------------------
def agregaPuesto(codigo, descripcion, areaSolicitante, sueldo):
    """
    Busca linealmente en la lista para validar que no exista otro puesto
    con el mismo código, descripción o área solicitante.
    Si no hay duplicados, inserta el nuevo puesto.
    """
    for p in puestos:
        if p.codigo == codigo:
            print(f"[ERROR] Ya existe un puesto con el código {codigo}.")
            return False
        if p.descripcion == descripcion:
            print(f"[ERROR] Ya existe un puesto con la descripción '{descripcion}'.")
            return False
        if p.areaSolicitante == areaSolicitante:
            print(f"[ERROR] Ya existe un puesto con el área solicitante '{areaSolicitante}'.")
            return False

    puestos.append(Puesto(codigo, descripcion, areaSolicitante, sueldo))
    print(f"[OK] Puesto '{descripcion}' (código {codigo}) agregado correctamente.")
    return True


# ---------------------------------------------------------------------------
# 2) MostrarTodo
# ---------------------------------------------------------------------------
def mostrarTodo():
    """Muestra todos los puestos de trabajo tal como están en la lista, sin ordenar."""
    if not puestos:
        print("No hay puestos de trabajo registrados.")
        return

    print("\n----- LISTA DE PUESTOS DE TRABAJO (sin ordenar) -----")
    for p in puestos:
        print(p)


# ---------------------------------------------------------------------------
# 3) BorraPuesto  (ordenamiento por inserción + búsqueda lineal)
# ---------------------------------------------------------------------------
def _ordenarInsercionPorCodigo():
    """Ordena la lista de puestos por código, de menor a mayor (método de inserción)."""
    for i in range(1, len(puestos)):
        actual = puestos[i]
        j = i - 1
        while j >= 0 and puestos[j].codigo > actual.codigo:
            puestos[j + 1] = puestos[j]
            j -= 1
        puestos[j + 1] = actual


def borraPuesto(codigo):
    """
    Ordena la lista por código (inserción) y luego busca linealmente
    el puesto cuyo código coincide para eliminarlo.
    """
    if not puestos:
        print("No hay puestos de trabajo registrados.")
        return

    _ordenarInsercionPorCodigo()

    for i in range(len(puestos)):
        if puestos[i].codigo == codigo:
            eliminado = puestos.pop(i)
            print(f"[OK] Puesto eliminado: {eliminado}")
            return

    print(f"[ERROR] No se encontró ningún puesto con código {codigo}.")


# ---------------------------------------------------------------------------
# 4) BuscaSueldo  (ordenamiento por selección + búsqueda binaria)
# ---------------------------------------------------------------------------
def _ordenarSeleccionPorSueldoDesc():
    """Ordena la lista de puestos por sueldo, de mayor a menor (método de selección)."""
    n = len(puestos)
    for i in range(n - 1):
        indiceMayor = i
        for j in range(i + 1, n):
            if puestos[j].sueldo > puestos[indiceMayor].sueldo:
                indiceMayor = j
        if indiceMayor != i:
            puestos[i], puestos[indiceMayor] = puestos[indiceMayor], puestos[i]


def _busquedaBinariaSueldo(sueldoBuscado):
    """Busca un sueldo en la lista (ordenada descendente) usando búsqueda binaria.
    Devuelve el índice de UNA coincidencia, o -1 si no existe."""
    izquierda, derecha = 0, len(puestos) - 1
    while izquierda <= derecha:
        medio = (izquierda + derecha) // 2
        if puestos[medio].sueldo == sueldoBuscado:
            return medio
        elif puestos[medio].sueldo > sueldoBuscado:
            # Como está de mayor a menor, si el valor medio es mayor,
            # el buscado está más a la derecha.
            izquierda = medio + 1
        else:
            derecha = medio - 1
    return -1


def buscaSueldo(sueldoBuscado):
    """
    Ordena la lista por sueldo (selección, de mayor a menor), ubica UNA
    coincidencia con búsqueda binaria y luego expande solo hacia los lados
    contiguos (sin recorrer toda la lista) para hallar el resto de puestos
    con el mismo sueldo, ya que al estar ordenada quedan justo al lado.
    """
    if not puestos:
        print("No hay puestos de trabajo registrados.")
        return

    _ordenarSeleccionPorSueldoDesc()
    indice = _busquedaBinariaSueldo(sueldoBuscado)

    if indice == -1:
        print(f"No se encontraron puestos con sueldo S/ {sueldoBuscado:,.2f}.")
        return

    resultados = [puestos[indice]]

    izq = indice - 1
    while izq >= 0 and puestos[izq].sueldo == sueldoBuscado:
        resultados.append(puestos[izq])
        izq -= 1

    der = indice + 1
    while der < len(puestos) and puestos[der].sueldo == sueldoBuscado:
        resultados.append(puestos[der])
        der += 1

    print(f"\nSe encontraron {len(resultados)} puesto(s) con sueldo S/ {sueldoBuscado:,.2f}:")
    for p in resultados:
        print(p)


# ---------------------------------------------------------------------------
# 5) ListaMasValiosa  (ordenamiento burbuja + algoritmo de cambio de moneda)
# ---------------------------------------------------------------------------
def _ordenarBurbujaPorSueldoDesc():
    """Ordena la lista de puestos por sueldo, de mayor a menor (método de burbuja)."""
    n = len(puestos)
    for i in range(n - 1):
        for j in range(n - 1 - i):
            if puestos[j].sueldo < puestos[j + 1].sueldo:
                puestos[j], puestos[j + 1] = puestos[j + 1], puestos[j]


def listaMasValiosa(monto):
    """
    Ordena los puestos por sueldo (burbuja, de mayor a menor) y aplica el
    algoritmo de cambio de moneda: recorre la lista tomando cada puesto
    cuyo sueldo todavía "quepa" en el monto restante, igual que se eligen
    las monedas de mayor a menor denominación para dar un cambio.
    """
    if not puestos:
        print("No hay puestos de trabajo registrados.")
        return

    _ordenarBurbujaPorSueldoDesc()

    seleccionados = []
    restante = monto

    for p in puestos:
        if p.sueldo <= restante:
            seleccionados.append(p)
            restante -= p.sueldo

    print(f"\nCon un presupuesto de S/ {monto:,.2f} se podrían cubrir estos puestos:")
    if not seleccionados:
        print("Ningún puesto cabe dentro de ese presupuesto.")
    else:
        for p in seleccionados:
            print(p)
        print(f"Total invertido: S/ {monto - restante:,.2f}")
        print(f"Sobrante sin usar: S/ {restante:,.2f}")


# ---------------------------------------------------------------------------
# Menú interactivo
# ---------------------------------------------------------------------------
def menu():
    while True:
        print("\n===== MENÚ DE PUESTOS DE TRABAJO =====")
        print("1 - AgregaPuesto()")
        print("2 - MostrarTodo()")
        print("3 - BorraPuesto()")
        print("4 - BuscaSueldo()")
        print("5 - ListaMasValiosa()")
        print("6 - Salir")

        opcion = input("Elija una opción: ").strip()

        if opcion == "1":
            try:
                codigo = int(input("Código: "))
                descripcion = input("Descripción: ").strip()
                area = input("Área solicitante: ").strip()
                sueldo = float(input("Sueldo: "))
                agregaPuesto(codigo, descripcion, area, sueldo)
            except ValueError:
                print("[ERROR] Código y sueldo deben ser numéricos.")

        elif opcion == "2":
            mostrarTodo()

        elif opcion == "3":
            try:
                codigo = int(input("Código del puesto a borrar: "))
                borraPuesto(codigo)
            except ValueError:
                print("[ERROR] El código debe ser numérico.")

        elif opcion == "4":
            try:
                sueldo = float(input("Sueldo a buscar: "))
                buscaSueldo(sueldo)
            except ValueError:
                print("[ERROR] El sueldo debe ser numérico.")

        elif opcion == "5":
            try:
                monto = float(input("Monto a invertir en salarios: "))
                listaMasValiosa(monto)
            except ValueError:
                print("[ERROR] El monto debe ser numérico.")

        elif opcion == "6":
            print("Saliendo del programa...")
            break

        else:
            print("Opción inválida, intente de nuevo.")


