import random
entrenadores = []
def nuevoEnt(tupla):
    nomEnt = input("Ingrese el nombre del entrenador: ")
    nomPokemon = input("Ingrese el nombre del pokemon: ")
    ataque = random.randint(150, 250)
    vida = random.randint(500, 900)
    nuevosDatos = (nomEnt, nomPokemon, ataque, vida)
    tupla.append(nuevosDatos)
    print(f"\nEntrenador '{nomEnt}' con pokemon '{nomPokemon}' creado con éxito.")
    print(f"Ataque: {ataque} | Vida: {vida}\n")
def listaEntrenador(tupla):
    if len(tupla) == 0:
        print("No hay entrenadores guardados")
        return
    listOrd = tupla.copy()
    n = len(listOrd)
    for i in range(n - 1):
        for j in range(n - 1 - i):
            if listOrd[j][2] > listOrd[j + 1][2]:
                listOrd[j], listOrd[j + 1] = listOrd[j + 1], listOrd[j]
    print("\n{:<4}{:<15}{:<15}{:<10}{:<10}".format("#", "Entrenador", "Pokemon", "Ataque", "Vida"))
    print("-" * 54)
    for indice, registro in enumerate(listOrd, start=1):
        nombreEntrenador, nombrePokemon, ataque, vida = registro
        print("{:<4}{:<15}{:<15}{:<10}{:<10}".format(indice, nombreEntrenador, nombrePokemon, ataque, vida))
    print()
    return listOrd
def borraPorPokemon(tupla):
    if len(tupla) == 0:
        print("No hay entrenadores registrados")
        return
    vidaBuscada = int(input("Ingrese el numero de vida a buscar: "))
    n = len(tupla)
    for i in range(n - 1):
        indiceMenor = i
        for j in range(i + 1, n):
            if tupla[j][3] < tupla[indiceMenor][3]:
                indiceMenor = j
        if indiceMenor != i:
            tupla[i], tupla[indiceMenor] = tupla[indiceMenor], tupla[i]
    izquierda = 0
    derecha = len(tupla) - 1
    posicionEncontrada = -1
    while izquierda <= derecha:
        medio = (izquierda + derecha) // 2
        vidaMedio = tupla[medio][3]
        if vidaMedio == vidaBuscada:
            posicionEncontrada = medio
            break
        elif vidaMedio < vidaBuscada:
            izquierda = medio + 1
        else:
            derecha = medio - 1
    if posicionEncontrada != -1:
        registroBorrado = tupla.pop(posicionEncontrada)
        print(f"\nSe eliminó {registroBorrado[0]} y al pokemon {registroBorrado[1]} (la vida: {registroBorrado[3]}).\n")
    else:
        print(f"\nNo hay ningún pokemon con esa cantidad de vida {vidaBuscada}.\n")
def peleaPokemon(lista):
    """Se enfrentan 2 pokemones. el perdedor sera eliminado de la lista"""
    if len(lista) < 2:
        print("\nSe necesitan minimo 2 entrenadores para la pelea.\n")
        return
    listaOrdenada = listaEntrenador(lista)
    try:
        numero1 = int(input("Ingrese el número del pokemon atacante: "))
        numero2 = int(input("Ingrese el número del pokemon defensor: "))
    except ValueError:
        print("\ninvalido\n")
        return
    if numero1 == numero2 or not (1 <= numero1 <= len(listaOrdenada)) or not (1 <= numero2 <= len(listaOrdenada)):
        print("\nSelección no valida.\n")
        return
    peleador1 = listaOrdenada[numero1 - 1]
    peleador2 = listaOrdenada[numero2 - 1]
    entrenador1, pokemon1, ataque1, vida1 = peleador1
    entrenador2, pokemon2, ataque2, vida2 = peleador2
    multiplicador1 = random.randint(0, 5)
    multiplicador2 = random.randint(0, 5)
    danio1 = ataque1 * multiplicador1 
    danio2 = ataque2 * multiplicador2  
    vidaFinal1 = vida1 - danio2
    vidaFinal2 = vida2 - danio1
    print(f"\n{pokemon1} ataca con {ataque1} x{multiplicador1} = {danio1} de daño.")
    print(f"{pokemon2} ataca con {ataque2} x{multiplicador2} = {danio2} de daño.")
    print(f"Vida restante de {pokemon1}: {vidaFinal1}")
    print(f"Vida restante de {pokemon2}: {vidaFinal2}\n")
    if vidaFinal1 <= 0 and vidaFinal2 <= 0:        
        lista.remove(peleador1)
        lista.remove(peleador2)
        print(f"Ambos pokemones ({pokemon1} y {pokemon2}) se quedaron sin vida. Ambos pierden\n")
    elif vidaFinal1 == vidaFinal2:
        lista.remove(peleador1)
        lista.remove(peleador2)
        print(f"Empate entre {pokemon1} y {pokemon2}! Ambos entrenadores pierden.\n")
    elif vidaFinal1 > vidaFinal2:
        lista.remove(peleador2)
        print(f"Ganó {entrenador1} con el pokemon {pokemon1}!\n")
    else:
        lista.remove(peleador1)
        print(f"Ganó {entrenador2} con el pokemon {pokemon2}!\n")
def mostrarMenu():
    print("\n    Menu de la batalla pokemon    ")
    print("1) Crear Entrenador")
    print("2) Listar Entrenadores")
    print("3) Borrar por Pokemon")
    print("4) Pelea Pokemon")
    print("5) Fin")
def main():
    opcion = 0
    while opcion != 5:
        mostrarMenu()
        try:
            opcion = int(input("Seleccione una opción: "))
        except ValueError:
            print("\nPor favor ingrese un número válido.\n")
            continue
        if opcion == 1:
            nuevoEnt(entrenadores)
        elif opcion == 2:
            listaEntrenador(entrenadores)
        elif opcion == 3:
            borraPorPokemon(entrenadores)
        elif opcion == 4:
            peleaPokemon(entrenadores)
        elif opcion == 5:
            print("\n¡Hasta luego, entrenador!\n")
        else:
            print("\nOpción no válida, intente nuevamente.\n")
if __name__ == "__main__":
    main()

